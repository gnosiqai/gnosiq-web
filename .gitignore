secrets*.json

# O GCP Console baixa a chave de service account com o nome PADRÃO
# `<project-id>-<hash>.json`, que nenhum padrão acima pegava. Continua sem
# `*.json` amplo, para não engolir config legítima.
project-*.json
*-[0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f]*.json
key.json
sa.json
*-sa.json
#Local recomendado para a chave admin (fora da árvore de fontes)
.secrets/


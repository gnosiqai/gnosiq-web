# GnosIQ — Environment Variables
# Copie este arquivo para .env.local e preencha os valores
# NUNCA commite .env.local no repositório

# Vercel (não necessário em .env.local — usados pelo CI/CD)
VERCEL_TOKEN=
VERCEL_ORG_ID=
VERCEL_PROJECT_ID=

# Analytics
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# Email (SendGrid)
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=

# GCP / Firestore — credencial do service account
#
# Runtime da aplicação (Vercel, local dev): APENAS a forma inline. Não há
# sistema de arquivos confiável em serverless, então lib/firestore.ts lê o
# CONTEÚDO do JSON, não um caminho. Ambas as variáveis abaixo são obrigatórias
# e a inicialização falha alto se qualquer uma faltar — sem project-id default.
#
#   GCP_PROJECT_ID                       ID do projeto GCP (não é secret)
#   GOOGLE_APPLICATION_CREDENTIALS_JSON  conteúdo do service-account.json
#
# bash/zsh:    export GOOGLE_APPLICATION_CREDENTIALS_JSON="$(cat chave.json)"
# PowerShell:  $env:GOOGLE_APPLICATION_CREDENTIALS_JSON = Get-Content chave.json -Raw
GCP_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS_JSON=
#
# Scripts administrativos avulsos (scripts/*.mjs, rodados da máquina do
# founder) aceitam TAMBÉM o caminho para o arquivo — mais prático que colar o
# JSON inteiro no shell. Ignorado pelo runtime da aplicação.
#
#   GOOGLE_APPLICATION_CREDENTIALS       caminho para o service-account.json
GOOGLE_APPLICATION_CREDENTIALS=

# Stripe (M2)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# AI APIs (M2)
ANTHROPIC_API_KEY=
GOOGLE_AI_API_KEY=
